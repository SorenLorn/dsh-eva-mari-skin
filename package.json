{
  "name": "dsh-mari-skin",
  "version": "1.2.2",
  "description": "真希波 EVA 装甲 HUD 皮肤：整体视觉由 CSS 变量与伪元素实现，开机时临时在 <html> 挂载不参与 DSH React 树的视频组件，播放结束立即移除。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./skin.css": "./skin.css",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "skin.css",
    "assets/**",
    "cordis.patch.yml",
    "screenshots.json",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SorenLorn/dsh-eva-mari-skin.git"
  },
  "homepage": "https://github.com/SorenLorn/dsh-eva-mari-skin#readme",
  "bugs": {
    "url": "https://github.com/SorenLorn/dsh-eva-mari-skin/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "skin",
    "theme",
    "mari",
    "evangelion"
  ],
  "license": "MIT"
}
